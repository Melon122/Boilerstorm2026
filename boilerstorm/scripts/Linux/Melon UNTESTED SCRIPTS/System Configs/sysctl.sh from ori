#!/bin/bash

# Check for root permissions
if [[ $EUID -ne 0 ]]; then
    echo "This script must be run as root"
    exit 1
fi

# Define the sysctl configuration file path
config_file="/etc/sysctl.conf"

# Define an array of configurations to modify
configurations=(
    # File system security
    'fs.file-max = 65535'
    'fs.protected_fifos = 2'
    'fs.protected_regular = 2'
    'fs.suid_dumpable = 0'
    'fs.protected_symlinks = 1'
    'fs.protected_hardlinks = 1'
    'fs.inotify.max_user_watches = 524288'
    'fs.inotify.max_user_instances = 512'
    'fs.suid_dumpable = 0'                         
    
    # Kernel security
    'kernel.keys.maxkeys = 2000'
    'kernel.keys.maxbytes = 40000'
    'kernel.yama.ptrace_scope = 3'              
    'kernel.kexec_load_disabled = 1'
    'kernel.exec-shield = 1'           
    'kernel.core_pattern=|/bin/false'
    'kernel.core_uses_pid = 1'
    'kernel.dmesg_restrict = 1'
    'kernel.randomize_va_space = 2'
    'kernel.pid_max = 65536'
    'kernel.panic = 10'
    'kernel.panic_on_oops = 1'
    'kernel.kptr_restrict = 2'
    'kernel.unprivileged_bpf_disabled = 1'
    'kernel.unprivileged_userns_clone = 0'
    'kernel.perf_event_paranoid = 3'
    'kernel.modules_disabled = 1'
    'kernel.sysrq = 0'
    'kernel.ctrl-alt-del = 0'
    'kernel.maps_protect = 1'            
    'kernel.msgmnb = 65535'
    'kernel.msgmax = 65535'
    'kernel.sem = 250 32000 100 128'             
    'kernel.chaos_read_threshold = 1'              
    
    # Virtual memory settings
    'vm.mmap_min_addr = 65536'
    'vm.panic_on_oom = 1'
    'vm.swappiness = 10'
    'vm.dirty_ratio = 20'
    'vm.dirty_background_ratio = 5'
    'vm.max_map_count = 262144'
    'vm.unprivileged_userfaultfd = 0'
    
    # Network security - Core
    'net.core.rmem_max = 16777216'
    'net.core.wmem_max = 16777216'
    'net.core.netdev_max_backlog = 10000'
    'net.core.somaxconn = 65535'
    'net.core.bpf_jit_harden = 2'
    'net.core.dev_weight = 64'
    
    # Network security - IPv4
    'net.ipv4.tcp_max_orphans = 65536'
    'net.ipv4.tcp_orphan_retries = 0'
    'net.ipv4.tcp_rfc1337 = 1'
    'net.ipv4.tcp_max_tw_buckets = 131072'
    'net.ipv4.tcp_tw_reuse = 1'
    'net.ipv4.tcp_fin_timeout = 15'
    'net.ipv4.ip_forward = 0'
    'net.ipv4.conf.all.forwarding = 0'
    'net.ipv4.conf.default.forwarding = 0'
    'net.ipv4.conf.all.accept_redirects = 0'
    'net.ipv4.conf.default.accept_redirects = 0'
    'net.ipv4.conf.all.secure_redirects = 0'
    'net.ipv4.conf.default.secure_redirects = 0'
    'net.ipv4.conf.all.send_redirects = 0'
    'net.ipv4.conf.default.send_redirects = 0'
    'net.ipv4.icmp_echo_ignore_all = 1'
    'net.ipv4.icmp_echo_ignore_broadcasts = 1'
    'net.ipv4.icmp_ignore_bogus_error_responses = 1'
    'net.ipv4.tcp_max_syn_backlog = 4096'
    'net.ipv4.tcp_synack_retries = 2'
    'net.ipv4.tcp_syncookies = 1'
    'net.ipv4.tcp_timestamps = 0'                 
    'net.ipv4.tcp_syn_retries = 2'
    'net.ipv4.conf.all.rp_filter = 1'
    'net.ipv4.conf.default.rp_filter = 1'
    'net.ipv4.tcp_sack = 0'
    'net.ipv4.tcp_dsack = 0'
    'net.ipv4.conf.all.bootp_relay = 0'
    'net.ipv4.conf.all.proxy_arp = 0'
    'net.ipv4.conf.all.arp_ignore = 1'
    'net.ipv4.conf.all.arp_announce = 2'
    'net.ipv4.conf.all.accept_source_route = 0'
    'net.ipv4.conf.default.accept_source_route = 0'
    'net.ipv4.conf.all.log_martians = 1'
    'net.ipv4.conf.default.log_martians = 1'
    'net.ipv4.tcp_keepalive_probes = 5'
    'net.ipv4.tcp_keepalive_intvl = 15'
    'net.ipv4.neigh.default.gc_thresh2 = 1024'
    'net.ipv4.tcp_retries2 = 8'                   
    'net.ipv4.tcp_retries1 = 3'
    'net.ipv4.route.flush = 1'
    'net.ipv4.tcp_mem = 8388608 8388608 8388608'
    'net.ipv4.udp_mem = 8388608 8388608 8388608'
)
echo "none integrity [confidentiality]" | sudo tee /sys/kernel/security/lockdown

# Ask user if IPv6 is needed
read -p "Do you need IPv6? (y/n): " ipv6Needed
ipv6Needed=$(echo "$ipv6Needed" | tr '[:upper:]' '[:lower:]')

# Define IPv6 configurations based on user choice
if [[ "$ipv6Needed" == "y" ]]; then
    ipv6_configurations=(
    # Router Advertisement Controls
    'net.ipv6.conf.all.accept_ra = 0'
    'net.ipv6.conf.default.accept_ra = 0'
    'net.ipv6.conf.all.accept_ra_defrtr = 0'
    'net.ipv6.conf.default.accept_ra_defrtr = 0'
    'net.ipv6.conf.all.accept_ra_pinfo = 0'
    'net.ipv6.conf.default.accept_ra_pinfo = 0'
    'net.ipv6.conf.all.accept_ra_rtr_pref = 0'
    'net.ipv6.conf.default.accept_ra_rtr_pref = 0'
    
    # Auto Configuration Controls
    'net.ipv6.conf.all.autoconf = 0'
    'net.ipv6.conf.default.autoconf = 0'
    'net.ipv6.conf.all.dad_transmits = 0'
    'net.ipv6.conf.default.dad_transmits = 0'
    'net.ipv6.conf.all.max_addresses = 1'
    'net.ipv6.conf.default.max_addresses = 1'
    'net.ipv6.conf.all.router_solicitations = 0'
    'net.ipv6.conf.default.router_solicitations = 0'
    
    # Redirect Controls
    'net.ipv6.conf.all.accept_redirects = 0'
    'net.ipv6.conf.default.accept_redirects = 0'
    'net.ipv6.conf.all.accept_source_route = 0'
    'net.ipv6.conf.default.accept_source_route = 0'
    
    # Forwarding Controls
    'net.ipv6.conf.all.forwarding = 0'
    'net.ipv6.conf.default.forwarding = 0'
    
    # Privacy Extensions
    'net.ipv6.conf.all.use_tempaddr = 2'
    'net.ipv6.conf.default.use_tempaddr = 2'
    
    # Additional Security Controls
    'net.ipv6.conf.all.rp_filter = 1'
    'net.ipv6.conf.default.rp_filter = 1'
    'net.ipv6.route.flush = 1'
    
    # New Security Enhancements
    'net.ipv6.conf.all.accept_untracked_na = 0'    # Prevent accepting untracked neighbor advertisements
    'net.ipv6.conf.default.accept_untracked_na = 0'
    'net.ipv6.conf.all.drop_unsolicited_na = 1'    # Drop unsolicited neighbor advertisements
    'net.ipv6.conf.default.drop_unsolicited_na = 1'
    'net.ipv6.conf.all.keep_addr_on_down = 0'      # Remove addresses when interface goes down
    'net.ipv6.conf.default.keep_addr_on_down = 0'
    'net.ipv6.conf.all.addr_gen_mode = 1'          # Use stable privacy addressing
    'net.ipv6.conf.default.addr_gen_mode = 1'
    
    # ICMPv6 Security
    'net.ipv6.icmp.ratelimit = 1000'               # Rate limit ICMPv6 messages
    'net.ipv6.conf.all.ignore_routes_with_linkdown = 1'  # Ignore routes when link is down
    'net.ipv6.conf.default.ignore_routes_with_linkdown = 1'
    
    # Neighbor Discovery Protocol Security
    'net.ipv6.neigh.default.gc_thresh1 = 128'      # Neighbor table garbage collection thresholds
    'net.ipv6.neigh.default.gc_thresh2 = 512'
    'net.ipv6.neigh.default.gc_thresh3 = 1024'
    'net.ipv6.neigh.default.base_reachable_time_ms = 30000'  # Reduce neighbor reachability time
    'net.ipv6.neigh.default.retrans_time_ms = 1000'
    
    # Flow Label Limits
    'net.ipv6.flowlabel_consistency = 1'           # Ensure flow label consistency
    'net.ipv6.auto_flowlabels = 0'                 # Disable automatic flow labels
    
    # Maximum Hop Limit
    'net.ipv6.conf.all.hop_limit = 64'             # Set maximum hop limit
    'net.ipv6.conf.default.hop_limit = 64'
)
    # Append IPv6 configurations to main configurations array
    configurations+=("${ipv6_configurations[@]}")
else
    ipv6_disable_configurations=(
        'net.ipv6.conf.all.disable_ipv6 = 1'
        'net.ipv6.conf.default.disable_ipv6 = 1'
        'net.ipv6.conf.lo.disable_ipv6 = 1'
    )
    # Append IPv6 disable configurations to main configurations array
    configurations+=("${ipv6_disable_configurations[@]}")
fi

# Clear the current sysctl.conf file
echo "# System hardening configuration - Generated on $(date)" > "$config_file"

# Write all configurations to sysctl.conf
for config in "${configurations[@]}"; do
    echo "$config" >> "$config_file"
done

# Apply kernel configurations
echo "Applying new kernel parameters..."
sysctl -p || { echo "Failed to apply kernel parameters"; exit 1; }

# Restart networking if IPv6 was disabled
if [[ "$ipv6Needed" != "y" ]]; then
    echo "Restarting networking service..."
    systemctl restart networking || systemctl restart network || echo "Failed to restart networking service"
fi

echo "Kernel hardening completed successfully."
